# Copy to .env and fill in. Full list: doc/riferimenti.md

# Auth: JWT signing key, at least 32 characters
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# DynamoDB (tables are created automatically on first start)
AWS_REGION=eu-central-1

# Optional: PDF import with Claude
ANTHROPIC_API_KEY=

# Optional: sovereign-bond risk (free key)
FRED_API_KEY=
